name: Сборка WinterControl

on:
  push:
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    name: Paper 1.21.4 — Java 21
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
      - name: Получить исходники
        uses: actions/checkout@v6

      - name: Установить Java 21
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'
          cache: maven

      - name: Собрать плагин
        run: mvn --batch-mode --no-transfer-progress clean package

      - name: Сохранить готовый JAR
        uses: actions/upload-artifact@v4
        with:
          name: WinterControl-Paper-1.21.4
          path: target/WinterControl.jar
          if-no-files-found: error